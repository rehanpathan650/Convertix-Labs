# --- Neon Postgres (Dashboard → Connection details → copy the pooled string) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-32+chars
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change-this-strong-password

# --- URLs ---
PORT=5000
NODE_ENV=development
# Used to build client invite links (no trailing slash)
CLIENT_URL=http://localhost:5173
# Set to false only if you serve over plain http in production
COOKIE_SECURE=true
